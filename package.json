{
  "name": "@anmitsu/ui",
  "version": "0.1.3",
  "description": "Shared look and layout for the anmitsu.dev apps: an MUI theme from the UI Kit design, plus the page pieces every app repeats.",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "sideEffects": [
    "./dist/fonts.js",
    "./src/fonts.ts",
    "*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./dates": {
      "types": "./dist/dates/index.d.ts",
      "import": "./dist/dates/index.js"
    },
    "./auth": {
      "types": "./dist/auth/index.d.ts",
      "import": "./dist/auth/index.js"
    },
    "./fonts": {
      "types": "./dist/fonts.d.ts",
      "import": "./dist/fonts.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "vite demo",
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "build:demo": "vite build demo",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint .",
    "test": "vitest run",
    "prepack": "yarn build"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.2.8",
    "@fontsource-variable/jetbrains-mono": "^5.2.8"
  },
  "peerDependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/icons-material": "^9.4.0",
    "@mui/material": "^9.4.0",
    "@mui/x-date-pickers": "^9.14.0",
    "dayjs": "^1.11.0",
    "oidc-client-ts": "^3.3.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-oidc-context": "^3.3.1"
  },
  "peerDependenciesMeta": {
    "@mui/x-date-pickers": {
      "optional": true
    },
    "dayjs": {
      "optional": true
    },
    "oidc-client-ts": {
      "optional": true
    },
    "react-oidc-context": {
      "optional": true
    }
  },
  "devDependencies": {
    "@emotion/react": "11.14.0",
    "@emotion/styled": "11.14.1",
    "@eslint/js": "10.0.1",
    "@mui/icons-material": "9.5.0",
    "@mui/material": "9.5.0",
    "@mui/x-date-pickers": "9.14.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react-swc": "4.3.3",
    "dayjs": "1.11.23",
    "eslint": "10.12.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "oidc-client-ts": "3.5.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-oidc-context": "3.3.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2",
    "vite": "8.3.0",
    "vitest": "5.0.4"
  },
  "packageManager": "yarn@4.12.0+sha512.f45ab632439a67f8bc759bf32ead036a1f413287b9042726b7cc4818b7b49e14e9423ba49b18f9e06ea4941c1ad062385b1d8760a8d5091a1a31e5f6219afca8"
}
